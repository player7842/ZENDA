# =====================================================================
# ZENDA — Variables para Docker Compose (archivo: .env en la raíz)
# Copia este archivo como ".env" y cambia los valores. NUNCA subas el .env.
# =====================================================================

# --- Base de datos (PostgreSQL) ---
DB_USER=zenda_user
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=zenda

# --- Autenticación ---
# Genera uno largo y aleatorio:  openssl rand -hex 32
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# --- Correo (solo recuperación de contraseña) ---
# Contraseña de aplicación de Gmail (16 caracteres), no la contraseña normal
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=contrasena_de_aplicacion

# --- Frontend ---
# URL pública del backend tal como la ve el NAVEGADOR (se fija al compilar)
VITE_API_URL=http://localhost:4000
