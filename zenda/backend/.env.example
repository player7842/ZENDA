# Copia este archivo y renómbralo a .env
# Este archivo NO se sube a GitHub (contiene credenciales)

# Puerto del backend
PORT=4000

# Credenciales de PostgreSQL
DB_USER=postgres
DB_PASSWORD=tu_contraseña_postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zenda

# Secreto para firmar los JWT (cámbialo por algo seguro)
JWT_SECRET=tu_frase_secreta_muy_larga
