# =====================================================================
# ZENDA Backend — Variables para ejecución LOCAL (archivo: backend/.env)
# Copia este archivo como ".env". NUNCA subas el .env.
# =====================================================================

# Puerto del servidor Express
PORT=4000

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=zenda
# En Neon (producción) debe ser "true"; en local con Docker, "false".
DB_SSL=false
# Neon usa certificados válidos. Deja "true" salvo que un proxy local
# intermedio presente un certificado autofirmado.
DB_SSL_REJECT_UNAUTHORIZED=true

# Alternativa a las variables DB_*: cadena completa de conexión. Si existe,
# tiene prioridad y fuerza SSL (Neon la exige).
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# --- Autenticación ---
# Obligatorio: el servidor se niega a arrancar si falta.
# Genera uno largo y aleatorio:  openssl rand -hex 32
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
# Sesión actual de 24 h. HU-004 la reducirá a 15 min + refresh.
JWT_SESSION_EXPIRES=24h

# Programa que puede gestionar el rol COORDINADOR (ADSO por defecto).
CODIGO_PROGRAMA_COORDINADOR=2338

# --- Correo (solo recuperación de contraseña) ---
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=contrasena_de_aplicacion

# URL pública del frontend, usada para CORS y para armar el enlace de
# recuperación. Admite varios orígenes separados por coma.
FRONTEND_URL=http://localhost:5173,http://localhost:8080
