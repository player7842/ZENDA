# =====================================================================
# ZENDA Backend — Variables para ejecución LOCAL (archivo: backend/.env)
# Copia este archivo como ".env". NUNCA subas el .env.
# =====================================================================

# Puerto del servidor Express
PORT=4000

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=zenda

# --- Autenticación ---
# Genera uno largo y aleatorio:  openssl rand -hex 32
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# --- Correo (solo recuperación de contraseña) ---
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=contrasena_de_aplicacion
